---
import { Badge } from "@/components/ui/badge"
import {
  PACKAGE_STATUS_LABELS,
  type PackageStatus,
} from "@/lib/package-status"

interface Props {
  status: PackageStatus
}

const { status } = Astro.props as Props

const labels = PACKAGE_STATUS_LABELS
---

<Badge
  variant="outline"
  className="h-5 rounded-md border-border/70 px-1.5 text-[11px] font-normal text-muted-foreground"
>
  {labels[status]}
</Badge>
