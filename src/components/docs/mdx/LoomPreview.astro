---
/**
 * Embeds a live, interactive Loom preview of a lattice-ui scene. Loom renders
 * the real Roblox `@rbxts/react` component tree in the browser, so the preview
 * is fully interactive (click, type, drag) — not a screenshot.
 *
 * The gallery is served by the `loom-preview` integration — Loom's own Vite
 * server in dev, a static bundle in `dist/loom-preview/` after a build — and the
 * iframe deep-links one target with `chrome=none`.
 * The iframe `src` is set lazily (IntersectionObserver) and carries the docs
 * site's current theme (`&theme=light|dark`); later toggles are pushed into
 * loaded frames via `postMessage({type:"loom-theme"})`.
 *
 * A "Code" tab shows the example scene's source, read at build time from the
 * same lattice checkout the gallery renders (override with
 * LATTICE_PREVIEW_APP). Docs-infra boilerplate (the
 * DocExampleShell import and the `preview` export) is stripped for display.
 */
import { Code } from "astro-expressive-code/components"
import {
  playgroundHref,
  readSceneSource,
  sceneTarget,
  stripSceneBoilerplate,
} from "@/lib/lattice-source"

interface Props {
  /** Scene module name, e.g. "SwitchExampleScene". */
  scene: string
  /** Iframe height in px. Scenes vary; default suits most single-panel demos. */
  height?: number
  /** Short caption under the frame. */
  label?: string
}

const { scene, height = 380, label } = Astro.props as Props

const target = sceneTarget(scene)
const previewSrc = `${import.meta.env.BASE_URL}loom-preview/index.html?target=${encodeURIComponent(
  target,
)}&chrome=none`

// --- example source (build-time read from the lattice checkout) -------------

const rawSource = readSceneSource(scene)
const sourceCode = rawSource ? stripSceneBoilerplate(rawSource) : undefined

// "Edit" opens the same scene in /playground, where the reader can change it
// and watch it re-render.
const editHref = rawSource
  ? playgroundHref(scene, import.meta.env.BASE_URL)
  : undefined
---

<figure class="not-prose my-6" data-loom-preview>
  <div class="overflow-hidden rounded-xl border border-border bg-card shadow-card">
    <div class="flex items-center justify-between border-b border-border bg-muted/40 px-2 py-1.5">
      <div class="flex items-center gap-1" role="tablist">
        <button
          aria-selected="true"
          class="rounded-md px-2.5 py-1 font-mono text-xs transition-colors data-[active=false]:text-muted-foreground data-[active=false]:hover:text-foreground data-[active=true]:bg-muted data-[active=true]:text-foreground"
          data-active="true"
          data-loom-tab="preview"
          role="tab"
          type="button"
        >
          Preview
        </button>
        {sourceCode ? (
          <button
            aria-selected="false"
            class="rounded-md px-2.5 py-1 font-mono text-xs transition-colors data-[active=false]:text-muted-foreground data-[active=false]:hover:text-foreground data-[active=true]:bg-muted data-[active=true]:text-foreground"
            data-active="false"
            data-loom-tab="code"
            role="tab"
            type="button"
          >
            Code
          </button>
        ) : null}
      </div>
      <div class="flex items-center gap-2">
        {editHref ? (
          <a
            class="inline-flex items-center gap-1 rounded-md px-2 py-1 font-mono text-xs text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
            href={editHref}
            title="Open this example in the playground"
          >
            Edit
            <svg
              aria-hidden="true"
              fill="none"
              height="11"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              width="11"
            >
              <path d="M7 17 17 7"></path>
              <path d="M8 7h9v9"></path>
            </svg>
          </a>
        ) : null}
        <span class="hidden px-1 font-mono text-[0.7rem] text-muted-foreground/70 sm:inline">
          Roblox UI · interactive
        </span>
      </div>
    </div>
    <div data-loom-panel="preview">
      <iframe
        class="block w-full bg-[#f6f9fc] dark:bg-[#12151a]"
        data-loom-frame
        data-src={previewSrc}
        height={height}
        loading="lazy"
        style={`height:${height}px`}
        title={`Live preview of ${scene}`}
      >
      </iframe>
    </div>
    {sourceCode ? (
      <div class="loom-code max-h-96 overflow-auto" data-loom-panel="code" hidden>
        <Code code={sourceCode} lang="tsx" title={`${scene}.loom.tsx`} />
      </div>
    ) : null}
  </div>
  {label ? (
    <figcaption class="mt-2 text-center text-sm text-muted-foreground">
      {label}
    </figcaption>
  ) : null}
</figure>

<style>
  /* The embedded expressive-code block should sit flush inside the card. */
  .loom-code :global(.expressive-code) {
    margin: 0;
  }
  .loom-code :global(.expressive-code .frame) {
    border-radius: 0;
    border: 0;
    box-shadow: none;
  }
</style>

<script>
  // Shared with VelaPreview — both embed the same kind of frame.
  import { mountLoomFrames, watchLoomTheme } from "@/lib/loom-frame"

  mountLoomFrames()
  watchLoomTheme()
  document.addEventListener("astro:after-swap", mountLoomFrames)
</script>
