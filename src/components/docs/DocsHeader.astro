---
import { ModeToggle } from "@/components/docs/ModeToggle"
import { SearchDialog } from "@/components/docs/SearchDialog"
import type { DocsProduct } from "@/lib/docs"

interface Props {
  product: DocsProduct
  docsHref: string
  navLinks: { label: string; href: string }[]
}

const { product, docsHref, navLinks } = Astro.props as Props
---

<header
  class="sticky top-0 z-50 w-full border-b border-border bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60"
  transition:persist="docs-header"
>
  <div class="mx-auto flex h-14 max-w-screen-2xl items-center px-4 sm:px-6 lg:px-8">
    <div class="mr-4 flex min-w-0 items-center">
      <button
        type="button"
        class="-ml-1 mr-2 inline-flex h-9 w-9 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-muted/50 hover:text-foreground lg:hidden"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="docs-mobile-nav-panel"
        data-mobile-nav-trigger
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>

      <a class="mr-6 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground" href="/">
        Docs
      </a>

      <nav class="hidden items-center gap-5 text-sm md:flex">
        <a class="font-medium text-foreground" href={docsHref}>
          {product.title}
        </a>
        {navLinks.map((link) => (
          <a
            class="text-muted-foreground transition-colors hover:text-foreground"
            href={link.href}
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>

    <div class="ml-auto flex items-center gap-2">
      <SearchDialog client:load />
      <a
        class="inline-flex h-9 w-9 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-muted/50 hover:text-foreground"
        href="https://discord.gg/e59Q65sadK"
        rel="noreferrer"
        target="_blank"
        aria-label="Join our Discord"
        title="Discord"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.058a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.331c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"
          ></path>
        </svg>
      </a>
      <a
        class="hidden text-sm text-muted-foreground transition-colors hover:text-foreground md:inline-flex"
        href={product.githubUrl}
        rel="noreferrer"
        target="_blank"
      >
        GitHub
      </a>
      <ModeToggle client:load />
    </div>
  </div>
</header>
