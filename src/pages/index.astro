---
import DocsCard from "@/components/docs/DocsCard.astro"
import ThemeScript from "@/components/docs/ThemeScript.astro"
import { DOCS_PRODUCTS, DOCS_PRODUCT_ORDER } from "@/lib/docs"
import { ClientRouter } from "astro:transitions"
import "@/styles/global.css"

const products = DOCS_PRODUCT_ORDER.map((id) => DOCS_PRODUCTS[id])
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Documentation for astra-void projects."
    />
    <title>astra-void docs</title>
    <ClientRouter />
    <ThemeScript />
  </head>
  <body class="min-h-screen bg-background font-sans text-foreground antialiased">
    <main class="mx-auto flex min-h-screen w-full max-w-4xl flex-col justify-center px-4 py-16 sm:px-6 lg:px-8">
      <section class="max-w-2xl">
        <h1 class="scroll-m-20 text-4xl font-bold tracking-tight lg:text-5xl">
          astra-void docs
        </h1>
        <p class="mt-4 text-lg leading-8 text-muted-foreground">
          Documentation for astra-void projects.
        </p>
        <div class="mt-6 flex items-center gap-3">
          <a
            class="inline-flex h-9 items-center gap-2 rounded-md bg-[#5865F2] px-4 text-sm font-medium text-white transition-opacity hover:opacity-90"
            href="https://discord.gg/e59Q65sadK"
            rel="noreferrer"
            target="_blank"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.058a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.331c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"
              ></path>
            </svg>
            Join our Discord
          </a>
        </div>
      </section>

      <section class="mt-10 grid max-w-2xl gap-3 sm:grid-cols-2">
        {products.map((product) => (
          <DocsCard
            title={product.title}
            description={product.description}
            href={product.href}
          />
        ))}
      </section>
    </main>
  </body>
</html>
